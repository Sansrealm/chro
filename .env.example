# Copy to .env locally. Never commit a real password or API key.
# Blank optional keys keep deterministic synthetic routing and method review.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
APP_PASSWORD=
PORT=8787
BIND_HOST=127.0.0.1
STATE_DIR=.state
# Set only when serving behind a reverse proxy; exact scheme and host, no path.
PUBLIC_ORIGIN=
